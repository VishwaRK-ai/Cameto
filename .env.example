# LLM Provider Configuration
GROQ_API_KEY="<YOUR_GROQ_API_KEY_HERE>"
GROQ_MODEL=llama-3.1-8b-instant

# Google Gemini API & Multimodal Vision/Audio
GEMINI_API_KEY="<YOUR_GEMINI_API_KEY_HERE>"
GEMINI_MODEL=gemini-3.8-flash

# Google Cloud / Google Fact Check Tools API
FACTCHECK_API_KEY="<YOUR_GOOGLE_FACTCHECK_API_KEY_HERE>"

# Optional Hugging Face Inference API
HUGGINGFACE_API_KEY="<YOUR_HUGGING_FACE_API_KEY_HERE>"

# Service Ports
PORT=8000
IMAGE_API_PORT=8001
